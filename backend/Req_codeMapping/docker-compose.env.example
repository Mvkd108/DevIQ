# DevHouse26 Environment Configuration
# Copy this file to docker-compose.env and customize for your deployment

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_USER=devhouse26
DB_PASSWORD=changeme_in_production_use_strong_password
DB_NAME=devhouse26

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_PASSWORD=redis_secure_password

# ============================================
# SECURITY KEYS (GENERATE STRONG VALUES!)
# ============================================
# Generate JWT secret: openssl rand -hex 32
JWT_SECRET=your_64_character_hex_string_here_generate_with_openssl

# Generate encryption key: openssl rand -base64 32
ENCRYPTION_KEY=your_44_character_base64_string_here

# ============================================
# FEATURE FLAGS
# ============================================
# Enable calendar integration (Google/Outlook)
ENABLE_CALENDAR_INTEGRATION=false

# ============================================
# EMAIL/SMTP (Optional - for burnout alerts)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=DevHouse26 Alerts <alerts@yourcompany.com>

# ============================================
# SLACK INTEGRATION (Optional)
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# CORS (Restrict to your domain in production)
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://devhouse26.yourcompany.com,https://app.yourcompany.com

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# URL where backend API is accessible
NEXT_PUBLIC_API_URL=https://api.devhouse26.yourcompany.com
