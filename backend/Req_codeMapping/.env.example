SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

REQ_MATCH_MODEL=BAAI/bge-small-en-v1.5
REQ_MATCH_THRESHOLD=0.45
REQ_MATCH_MAX_PATCH_CHARS=4000
REQ_MATCH_MAX_COMMIT_TEXT_CHARS=12000
REQ_MATCH_TOP_MATCHES=25

# Numeric values are validated at startup. Invalid or out-of-range values
# fall back to safe defaults and appear in GET /api/health warnings.

# Optional: protect write endpoints such as /api/sync, /api/mapping-feedback,
# and /api/project-intake. Leave empty for local/demo mode.
DEVHOUSE_WRITE_API_KEY=

# Optional: disable local JSON fallback for mapping feedback and require
# Supabase-backed persistence only. Recommended for deployed environments
# after SQL migrations have been applied.
DEVHOUSE_DISABLE_FILE_FALLBACK=false

# Optional: cache Supabase table-availability probes used by the health and
# dashboard metadata endpoints to reduce repeated storage checks.
DEVHOUSE_STORAGE_PROBE_TTL_SECONDS=30

# Optional: persist dashboard analytics snapshots in Supabase and serve them
# when still fresh. This reduces request-time recomputation for launch-critical
# dashboard views.
DEVHOUSE_ANALYTICS_SNAPSHOTS_ENABLED=true
DEVHOUSE_ANALYTICS_SNAPSHOT_MAX_AGE_SECONDS=120

# =================================================================
# NOVELTY FEATURES (Option A Implementation)
# Burnout Detection & Predictive Delivery
# =================================================================

# Burnout Early Warning System
DEVHOUSE_BURNOUT_DETECTION_ENABLED=true
DEVHOUSE_BURNOUT_ALERTS_ENABLED=false
BURNOUT_SLACK_WEBHOOK_URL=                    # Optional: for Slack notifications
BURNOUT_ALERT_EMAIL=                          # Optional: for email alerts
BURNOUT_CHECK_DAY=sunday                      # Day of week for analysis
BURNOUT_CHECK_HOUR=9                          # Hour (24h) for analysis

# Predictive Delivery Intelligence
DEVHOUSE_PREDICTIVE_DELIVERY_ENABLED=true
DEVHOUSE_PREDICTION_CACHE_TTL_HOURS=24        # How long to cache predictions
DEVHOUSE_DELIVERY_RISK_THRESHOLD_LOW=70       # Probability % below = low risk
DEVHOUSE_DELIVERY_RISK_THRESHOLD_HIGH=50      # Probability % below = high risk

# GitHub Connector Configuration (for real PR/CI/Deploy data)
# Get yours at: https://github.com/settings/tokens
DEVHOUSE_GITHUB_TOKEN=ghp_your_github_token_here
DEVHOUSE_GITHUB_ENABLED=true
DEVHOUSE_GITHUB_ENTERPRISE_URL=
