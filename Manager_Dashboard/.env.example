VITE_API_BASE_URL=http://127.0.0.1:8000

# Local startup rule:
# - start backend/Req_codeMapping first
# - confirm http://127.0.0.1:8000/api/health
# - confirm http://127.0.0.1:8000/api/dashboard and /api/delivery-timeline also return JSON
# - then run the dashboard
# - confirm rollout_assessment.pilot.status is not blocked before a pilot demo

# This should match the Req_codeMapping backend you actually started.
# For local evaluation the default is http://127.0.0.1:8000.
# For a controlled pilot, keep this pointed at a single known backend and avoid switching targets mid-session.

# Optional: required only when DEVHOUSE_WRITE_API_KEY is set in the backend.
# Keep this identical to DEVHOUSE_WRITE_API_KEY when write protection is enabled.
# For pilot use, verify this before any live write-action demo, including manual intake.
VITE_WRITE_API_KEY=
